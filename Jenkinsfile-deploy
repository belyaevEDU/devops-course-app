library 'repeating-functions'

def deployed = false

pipeline {
    agent none

    environment {
        DOCKER_IMAGE = 'belyaevedu/restapi-currency'
    }

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Deploy') {
            when {
                expression { params.ENVIRONMENT ==~ /(production|staging)/ }
            }
            agent { label params.ENVIRONMENT }
            steps {
                checkout scm

                sh "IMAGE_TAG=${params.IMAGE_TAG} docker compose pull"
                sh 'touch .env'
                sh "IMAGE_TAG=${params.IMAGE_TAG} docker compose up -d"

                script {
                    env.DEPLOY_AGENT = params.ENVIRONMENT
                    deployed = true
                }
            }
        }
        stage('Smoke test') {
            when {
                expression { deployed }
            }
            agent { label params.ENVIRONMENT }
            steps {
                healthCheckLoop('127.0.0.1:8000/info', 10, 3)
            }
        }
    }

    post {
        always {
            node(env.DEPLOY_AGENT ?: 'staging') {
                script {
                    if (deployed) {
                        sh "docker rmi ${DOCKER_IMAGE}:${params.IMAGE_TAG} || true"
                    }
                }
                cleanWs()
            }
        }
    }
}
